        <!-- Optional for MINA SSHD, and worth having on two counts: it widens the private
             key formats a tunnel can accept, and without it a native build stops on
             sshd's post-quantum key exchange, which references classes that would then
             have no implementation. -->
        <!--
            Places a sign-in in a country, so an account used from somewhere it has never been used
            from can say so. Reads a local database file an operator supplies; nothing is asked of
            anybody over the network, because that would mean telling a third party who signs in
            here and from where. Without the file the library is simply never used.
        -->
        <dependency>
            <groupId>com.maxmind.geoip2</groupId>
            <artifactId>geoip2</artifactId>
