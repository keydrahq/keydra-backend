# Editor settings, so a contributor's IDE agrees with Spotless before the build has to.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.java]
# google-java-format, which Spotless enforces.
indent_size = 4
max_line_length = 100

[*.{yml,yaml,json,graphql}]
indent_size = 2

[*.{md,adoc}]
# Trailing spaces are a line break in Markdown, so they are not whitespace to trim.
trim_trailing_whitespace = false

[*.properties]
indent_size = 2

[Makefile]
indent_style = tab

[{mvnw,mvnw.cmd}]
# Generated by Maven; left exactly as it ships.
trim_trailing_whitespace = false
insert_final_newline = false
